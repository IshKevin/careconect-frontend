# Copy to .env.local and adjust. NEXT_PUBLIC_ values are visible in the browser, so never put secrets here.

# Base URL of the backend API (careconect-bn). Local default: the API container on port 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Production: NEXT_PUBLIC_API_BASE_URL=https://api.isanomed.org/api/v1

# true shows one-click demo accounts on the login page. Create them on the backend first:
#   node dist/db/seed-demo.js   (in the api container)
# Set false before real launch, and suspend the accounts with: node dist/db/seed-demo.js --disable
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
